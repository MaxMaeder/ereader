/dts-v1/;

#include <nordic/nrf52840_qiaa.dtsi>
#include <dt-bindings/input/input-event-codes.h>
#include <dt-bindings/regulator/npm13xx.h>
#include "e_reader_prototype-pinctrl.dtsi"

/ {
	model = "E Reader Prototype";
	compatible = "mmaeder,e-reader-prototype";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &app_partition;

		zephyr,console = &cdc_acm_uart0;
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		app_partition: partition@0 {
			label = "image-0";
			reg = <0x00000 DT_SIZE_K(992)>;
		};

		storage_partition: partition@f8000 {
			label = "storage";
			reg = <0xf8000 DT_SIZE_K(32)>;
		};
	};
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

zephyr_udc0: &usbd {
	status = "okay";

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "CDC_ACM_0";
	};
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	pmic: pmic@6b {
		compatible = "nordic,npm1300";
		reg = <0x6b>;

		pmic_leds: led-controller {
			compatible = "nordic,npm1300-led";
			nordic,led0-mode = "host";
			nordic,led1-mode = "host";
			nordic,led2-mode = "host";
		};

		pmic_gpio: gpio-controller {
			compatible = "nordic,npm1300-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <5>;
		};

		pmic_regulators: regulators {
			compatible = "nordic,npm1300-regulator";
			status = "okay";

			pmic_buck1: BUCK1 {
				regulator-min-microvolt = <2500000>;
				regulator-max-microvolt = <3300000>;
				regulator-init-microvolt = <3300000>;
			};

			pmic_ldsw1: LDO1 {
				status = "okay";
				regulator-initial-mode = <NPM13XX_LDSW_MODE_LDSW>;
			};
		};
	};

	iqs323: iqs323@44 {
		compatible = "azoteq,iqs323";
		reg = <0x44>;
		rdy-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
		input-codes = <INPUT_KEY_0 INPUT_KEY_1 INPUT_KEY_2>;
	};
};

&spi2 {
	compatible = "nordic,nrf-spim";
	status = "okay";

	pinctrl-0 = <&spi2_default>;
	pinctrl-1 = <&spi2_sleep>;
	pinctrl-names = "default", "sleep";

	cs-gpios = <&gpio0 12 GPIO_ACTIVE_LOW>,
		   <&gpio0 16 GPIO_ACTIVE_LOW>,
		   <&gpio0 22 GPIO_ACTIVE_LOW>;

	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <8000000>;

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

/ {
	epd_mipi_dbi: mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi2>;
		dc-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 23 GPIO_ACTIVE_LOW>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		epd_left: epd_left@1 {
			compatible = "waveshare,5in-epaper";
			reg = <1>;
			mipi-max-frequency = <4000000>;
			width = <960>;
			height = <552>;
			busy-gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;

			softstart = [ae c7 c3 c0 80];
		};

		epd_right: epd_right@2 {
			compatible = "waveshare,5in-epaper";
			reg = <2>;
			mipi-max-frequency = <4000000>;
			width = <960>;
			height = <552>;
			busy-gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;

			softstart = [ae c7 c3 c0 80];
		};
	};
};
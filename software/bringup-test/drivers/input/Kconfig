config INPUT_IQS323
	bool "Azoteq IQS323 3-channel capacitive touch sensor"
	default y
	depends on DT_HAS_AZOTEQ_IQS323_ENABLED
	select I2C
	select GPIO
	help
	  Enable driver for the Azoteq IQS323 ProxFusion IC in 3-button
	  self-capacitance mode.  Touch events are reported through the
	  Zephyr input subsystem.
